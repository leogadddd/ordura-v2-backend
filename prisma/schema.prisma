// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Authentication & Authorization
// ============================================

model CommonUser {
  id        String  @id @default(cuid())
  email     String  @unique
  username  String  @unique
  password  String // hashed password
  firstName String?
  lastName  String?
  roleId    String? // Reference to detailed role
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  // Relations
  roleDetails               Role?                      @relation(fields: [roleId], references: [id])
  sessions                  Session[]
  orders                    Order[] // Orders created/handled by this employee
  transactions              SalesTransaction[] // Sales transactions handled by this employee
  userPermissions           UserPermission[]
  inventoryLevelAdjustments InventoryLevelAdjustment[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderNotes        PurchaseOrderNote[]
  customerEvents            CustomerEvent[]

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@map("CommonUsers")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  user CommonUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isProtected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users           CommonUser[]
  rolePermissions RolePermission[]

  @@index([name])
  @@index([isActive])
  @@map("Roles")
}

// Normalized permissions for RBAC
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "USERS:view"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roleMappings RolePermission[]
  userMappings UserPermission[]

  @@index([name])
  @@map("Permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("RolePermissions")
}

// Per-user permission overrides. These are applied on top of role permissions
// and may either explicitly allow or explicitly deny a permission for a user.
model UserPermission {
  id           String     @id @default(cuid())
  user         CommonUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  isAllowed    Boolean    @default(true) // true = allow, false = deny
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("UserPermissions")
}

// ============================================
// Product Management
// ============================================

// ------------------------
// Inventory
// ------------------------
model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLevels InventoryLevel[]

  @@index([name])
}

model Supplier {
  id                   String   @id @default(cuid())
  name                 String
  contactPerson        String?
  email                String?
  phone                String?
  address              String?
  deliveryLeadTimeDays Int?
  notes                String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contacts       SupplierContact[]
  tags           SupplierTag[]
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([isActive])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  name       String
  role       String?
  email      String?
  phone      String?
  notes      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([name])
}

model SupplierTag {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  label      String
  createdAt  DateTime @default(now())

  @@unique([supplierId, label])
  @@index([supplierId])
  @@index([label])
}

enum MeasurementUnit {
  PIECE
  ML
  L
  OZ
  G
  KG
}

model InventoryItem {
  id              String          @id @default(cuid())
  name            String
  description     String?
  measurementUnit MeasurementUnit @default(PIECE)
  lowThreshold    Int?
  shouldAlert     Boolean         @default(true)
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  levels             InventoryLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  productIngredients ProductIngredient[]

  @@index([name])
  @@index([supplierId])
  @@index([shouldAlert])
}

model InventoryLevel {
  id              String        @id @default(cuid())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId      String
  quantity        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adjustments InventoryLevelAdjustment[]

  @@unique([inventoryItemId, locationId])
  @@index([inventoryItemId])
  @@index([locationId])
}

model InventoryLevelAdjustment {
  id               String         @id @default(cuid())
  inventoryLevel   InventoryLevel @relation(fields: [inventoryLevelId], references: [id], onDelete: Cascade)
  inventoryLevelId String
  quantity         Int
  reason           String
  createdBy        CommonUser     @relation(fields: [createdById], references: [id])
  createdById      String
  createdAt        DateTime       @default(now())

  @@index([inventoryLevelId])
  @@index([createdById])
}

enum PurchaseOrderStatus {
  ORDERED
  DELIVERED
  RESCHEDULED
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId         String
  status             PurchaseOrderStatus @default(ORDERED)
  orderedAt          DateTime            @default(now())
  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdBy          CommonUser          @relation(fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items PurchaseOrderItem[]
  notes PurchaseOrderNote[]

  @@index([supplierId])
  @@index([status])
  @@index([orderedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String
  quantity        Int
  createdAt       DateTime      @default(now())

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}

model PurchaseOrderNote {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  note            String
  createdBy       CommonUser    @relation(fields: [createdById], references: [id])
  createdById     String
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([createdById])
}

// ============================================
// Product Management
// ============================================

model Product {
  id          String  @id
  sku         String  @unique // Auto-generated SKU
  name        String
  category    String
  description String?
  notes       String?

  // Pricing
  cost         Float // Cost price
  sellingPrice Float // Selling price

  // Status
  status  ProductStatus @default(ACTIVE)
  isDraft Boolean       @default(false)

  // Fulfillment Configuration
  requiresFulfillment Boolean          @default(false) // whether this product needs assembly/cooking/etc
  fulfillmentTypeId   String?
  fulfillmentType     FulfillmentType? @relation(fields: [fulfillmentTypeId], references: [id])

  // Ingredient recipe
  ingredients ProductIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([category])
  @@index([status])
  @@index([fulfillmentTypeId])
}

model ProductIngredient {
  id              String        @id @default(cuid())
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String
  quantity        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([productId, inventoryItemId])
  @@index([productId])
  @@index([inventoryItemId])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

// ============================================
// Sales & Orders
// ============================================

// ============================================
// Customer Management
// ============================================

enum CustomerGender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum AllergySeverity {
  UNKNOWN
  MILD
  MODERATE
  SEVERE
}

enum CustomerEventType {
  ORDER_CREATED
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_VOIDED
  REFUND_ISSUED
  NOTE
}

model Customer {
  id             String  @id @default(cuid())
  customerNumber String  @unique
  isActive       Boolean @default(true)

  // Basic information
  displayName String
  firstName   String?
  lastName    String?
  middleName  String?
  suffix      String?

  // Personal information
  gender      CustomerGender?
  dateOfBirth DateTime?
  occupation  String?
  company     String?

  // Contact information
  email          String?
  phone          String?
  alternatePhone String?

  // Address (simple, single address record)
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  emergencyContacts CustomerEmergencyContact[]
  foodAllergies     CustomerFoodAllergy[]
  tags              CustomerTag[]
  metrics           CustomerMetrics?
  events            CustomerEvent[]
  orders            Order[]
  salesTransactions SalesTransaction[]

  @@index([displayName])
  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@map("Customers")
}

model CustomerEmergencyContact {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  relationship String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([name])
  @@index([isPrimary])
  @@map("CustomerEmergencyContacts")
}

model CustomerFoodAllergy {
  id         String          @id @default(cuid())
  customerId String
  allergen   String
  severity   AllergySeverity @default(UNKNOWN)
  reaction   String?
  notes      String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([allergen])
  @@index([severity])
  @@index([isActive])
  @@map("CustomerFoodAllergies")
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  label      String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, label])
  @@index([customerId])
  @@index([label])
  @@map("CustomerTags")
}

model CustomerMetrics {
  id         String @id @default(cuid())
  customerId String @unique

  firstTransactionAt DateTime?
  lastTransactionAt  DateTime?

  ordersCount            Int @default(0)
  salesTransactionsCount Int @default(0)
  cancelledOrdersCount   Int @default(0)
  refundsCount           Int @default(0)

  lifetimeSpend Decimal @default(0) @db.Decimal(12, 2)
  avgOrderValue Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([lastTransactionAt])
  @@map("CustomerMetrics")
}

model CustomerEvent {
  id         String            @id @default(cuid())
  customerId String
  type       CustomerEventType
  occurredAt DateTime          @default(now())

  summary String?
  notes   String?

  // Optional links to source records
  orderId            String?
  salesTransactionId String?
  paymentId          String?
  createdById        String?
  metadata           Json?

  createdAt DateTime @default(now())

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  salesTransaction SalesTransaction? @relation(fields: [salesTransactionId], references: [id], onDelete: SetNull)
  payment          Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy        CommonUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([customerId, occurredAt])
  @@index([type])
  @@index([orderId])
  @@index([salesTransactionId])
  @@index([paymentId])
  @@index([createdById])
  @@map("CustomerEvents")
}

// Notes on design:
// - No hard relations to `Product`; we snapshot product info on each `OrderItem`
//   so historical orders remain correct even if the product changes later.
// - Monetary values use Decimal to avoid floating point issues.

enum OrderStatus {
  DRAFT
  OPEN
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderType {
  SALE
  RETURN
}

enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
  NONE
}

enum PaymentMethod {
  NONE
  CASH
  CARD
  MOBILE
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  NO_PAYMENT_NEEDED
  PENDING
  PAID
  VOID
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

model FulfillmentType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  fulfillments Fulfillment[]

  @@index([isActive])
  @@index([sortOrder])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  type        OrderType   @default(SALE)
  status      OrderStatus @default(OPEN)
  taxMode     TaxMode     @default(EXCLUSIVE)
  currency    String      @default("PHP")

  customerId String?

  // Customer snapshot (optional)
  customerName  String?
  customerPhone String?
  customerEmail String?

  // Totals
  subtotal      Decimal @db.Decimal(12, 2)
  orderDiscount Decimal @default(0) @db.Decimal(12, 2) // discount on subtotal
  discountTotal Decimal @default(0) @db.Decimal(12, 2) // line item discounts
  serviceFee    Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee   Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  paidTotal     Decimal @default(0) @db.Decimal(12, 2)
  changeDue     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal @default(0) @db.Decimal(12, 2)

  notes      String?
  employeeId String
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  // Relations
  employee       CommonUser      @relation(fields: [employeeId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEvents CustomerEvent[]
  items          OrderItem[]
  payments       Payment[]
  fulfillments   Fulfillment[]

  // Indexes
  @@index([status])
  @@index([customerId])
  @@index([employeeId])
  @@index([createdAt])
}

// New model: SalesTransaction - refactor target for Order
model SalesTransaction {
  id                String      @id @default(cuid())
  transactionNumber String      @unique
  type              OrderType   @default(SALE)
  status            OrderStatus @default(OPEN)
  taxMode           TaxMode     @default(EXCLUSIVE)
  currency          String      @default("PHP")

  customerId String?

  // Customer snapshot (optional)
  customerName  String?
  customerPhone String?
  customerEmail String?

  // Totals (same as Order)
  subtotal      Decimal @db.Decimal(12, 2)
  orderDiscount Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  serviceFee    Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee   Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  paidTotal     Decimal @default(0) @db.Decimal(12, 2)
  changeDue     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal @default(0) @db.Decimal(12, 2)

  notes      String?
  employeeId String
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  // Relations
  employee       CommonUser        @relation(fields: [employeeId], references: [id])
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEvents CustomerEvent[]
  items          TransactionItem[]
  payments       Payment[]
  fulfillments   Fulfillment[]

  // Indexes
  @@index([status])
  @@index([customerId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("SalesTransactions")
}

model TransactionItem {
  id            String @id @default(cuid())
  transactionId String
  lineNo        Int

  // Product snapshot (no FK)
  productId String?
  sku       String?
  name      String
  category  String?

  // Pricing
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  quantity  Decimal  @db.Decimal(12, 3)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  taxRate   Decimal? @db.Decimal(5, 4)
  taxAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())

  // Relations
  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([transactionId])
  @@map("TransactionItems")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  lineNo  Int

  // Product snapshot (no FK)
  productId String?
  sku       String?
  name      String
  category  String?

  // Pricing
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)
  quantity  Decimal  @db.Decimal(12, 3)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  taxRate   Decimal? @db.Decimal(5, 4) // e.g. 0.1200 for 12%
  taxAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([orderId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  salesTransactionId String?
  method             PaymentMethod
  status             PaymentStatus @default(PAID)
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("USD")
  reference          String?
  externalTxnId      String?
  receivedAt         DateTime      @default(now())
  metadata           Json?

  // Relations
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesTransaction SalesTransaction? @relation(fields: [salesTransactionId], references: [id], onDelete: Cascade)
  customerEvents   CustomerEvent[]

  // Indexes
  @@index([orderId])
  @@index([salesTransactionId])
  @@index([method])
  @@index([status])
  @@index([receivedAt])
}

// ============================================
// Fulfillment (Kitchen, Assembly, Preparation)
// ============================================

model Fulfillment {
  id                 String            @id @default(cuid())
  orderId            String
  salesTransactionId String?
  fulfillmentTypeId  String
  status             FulfillmentStatus @default(PENDING)

  // Assignment & Timing
  assignedTo            String? // employeeId - who's responsible
  priority              Int       @default(0)
  estimatedCompletionAt DateTime?
  startedAt             DateTime?
  completedAt           DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesTransaction SalesTransaction? @relation(fields: [salesTransactionId], references: [id], onDelete: Cascade)
  fulfillmentType  FulfillmentType   @relation(fields: [fulfillmentTypeId], references: [id])

  // Indexes
  @@index([orderId])
  @@index([salesTransactionId])
  @@index([status])
  @@index([fulfillmentTypeId])
  @@index([assignedTo])
  @@index([createdAt])
}
